{
  "name": "FlagStack",
  "image": "mcr.microsoft.com/devcontainers/go:1.26-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "postCreateCommand": "corepack enable && corepack prepare pnpm@11.22.0 --activate && cd frontend && pnpm install",
  "forwardPorts": [5173, 8080, 5432],
  "portsAttributes": {
    "5173": { "label": "FlagStack frontend" },
    "8080": { "label": "FlagStack API" },
    "5432": { "label": "PostgreSQL" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}

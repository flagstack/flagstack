{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagstack.dev/spec/sdk-config-v1.schema.json",
  "title": "FlagStack SDK configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "flags"],
  "properties": {
    "schema_version": { "const": 1 },
    "environment": { "$ref": "#/$defs/environment" },
    "flags": {
      "type": "array",
      "items": { "$ref": "#/$defs/flag" }
    },
    "segments": {
      "type": "array",
      "items": { "$ref": "#/$defs/segment" }
    }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "value": true
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant", "weight"],
      "properties": {
        "variant": { "type": "string", "minLength": 1 },
        "weight": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant": { "type": "string", "minLength": 1 },
        "rollout": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/allocation" }
        },
        "bucket_by": { "type": "string", "minLength": 1 }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator"],
      "properties": {
        "attribute": { "type": "string" },
        "operator": {
          "enum": [
            "equals",
            "not_equals",
            "in",
            "not_in",
            "contains",
            "not_contains",
            "starts_with",
            "ends_with",
            "greater_than",
            "greater_than_or_equal",
            "less_than",
            "less_than_or_equal",
            "exists",
            "not_exists",
            "matches_regex",
            "semver_greater_than",
            "semver_greater_than_or_equal",
            "semver_less_than",
            "semver_less_than_or_equal",
            "in_segment",
            "not_in_segment"
          ]
        },
        "value": true
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match", "conditions", "outcome"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "match": { "enum": ["all", "any"] },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/condition" }
        },
        "outcome": { "$ref": "#/$defs/outcome" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "fallthrough": { "$ref": "#/$defs/outcome" }
      }
    },
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key", "kind", "default_value", "enabled", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["boolean", "string", "number", "json"] },
        "default_value": true,
        "enabled": { "type": "boolean" },
        "variants": {
          "type": "array",
          "items": { "$ref": "#/$defs/variant" }
        },
        "policy": { "$ref": "#/$defs/policy" },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "match", "conditions"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "match": { "enum": ["all", "any"] },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/condition" }
        }
      }
    }
  }
}
